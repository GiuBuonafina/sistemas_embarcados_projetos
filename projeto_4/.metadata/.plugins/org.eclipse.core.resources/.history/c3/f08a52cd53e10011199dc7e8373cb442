/* ---------- funções de apoio ---------- */

static void uart_print(const char *s)
{
  HAL_UART_Transmit(&huart2, (uint8_t *)s, (uint16_t)strlen(s), 100);
}

/* converte o valor 0-255 em volts (texto), usando 3,3 V / 256 por degrau */
static void formata_volts(char *dest, size_t n, uint8_t valor)
{
  uint32_t mv = (uint32_t)valor * 3300u / 256u;
  snprintf(dest, n, "%lu.%02lu V", (unsigned long)(mv / 1000u), (unsigned long)((mv % 1000u) / 10u));
}

/* ---------- início das operações I2C (todas não bloqueantes) ---------- */

static void iniciar_leitura(uint8_t canal)
{
  canal_atual = canal;
  ctrl_tx = (dac_ligado ? CTRL_DAC_ON : 0x00) | canal;   /* mantém o DAC ligado, se já estava */
  estado_i2c = I2C_ENVIANDO_CANAL;
  if (HAL_I2C_Master_Transmit_IT(&hi2c1, PCF8591_ADDR, &ctrl_tx, 1) != HAL_OK) {
    estado_i2c = I2C_LIVRE;
    evento_i2c = EV_ERRO;
  }
}

static void iniciar_dac(uint8_t valor)
{
  dac_valor = valor;
  dac_tx[0] = CTRL_DAC_ON;     /* byte de controle: saída analógica ligada */
  dac_tx[1] = valor;           /* byte de dados: valor do DAC */
  estado_i2c = I2C_ENVIANDO_DAC;
  if (HAL_I2C_Master_Transmit_IT(&hi2c1, PCF8591_ADDR, dac_tx, 2) != HAL_OK) {
    estado_i2c = I2C_LIVRE;
    evento_i2c = EV_ERRO;
  }
}

/* ---------- interpreta o texto digitado no terminal ---------- */

static void processar_comando(const char *cmd)
{
  if (strcmp(cmd, "Read_AIN0") == 0) {
    iniciar_leitura(0);
  } else if (strcmp(cmd, "Read_AIN1") == 0) {
    iniciar_leitura(1);
  } else if (strcmp(cmd, "Read_AIN3") == 0) {
    iniciar_leitura(3);
  } else if (strcmp(cmd, "Read_AIN2") == 0) {
    uart_print("AIN2 sem uso na placa PCF8591\r\n");
  } else if (strncmp(cmd, "Set_DAC_", 8) == 0) {
    const char *p = cmd + 8;
    size_t n = strlen(p);
    int ok = (n > 0 && n <= 3);
    for (size_t i = 0; i < n && ok; i++) {
      if (!isdigit((unsigned char)p[i])) ok = 0;
    }
    int v = ok ? atoi(p) : -1;
    if (ok && v >= 0 && v <= 255) {
      iniciar_dac((uint8_t)v);
    } else {
      uart_print("Valor invalido. Use Set_DAC_<0 a 255>\r\n");
    }
  } else {
    uart_print("Comando invalido. Use: Read_AIN0, Read_AIN1, Read_AIN3, Set_DAC_<0-255>\r\n");
  }
}

/* ---------- reage aos eventos gerados pelos callbacks ---------- */

static void tratar_evento_i2c(void)
{
  char msg[80];
  char volts[16];
  EventoI2C ev = evento_i2c;
  evento_i2c = EV_NENHUM;

  switch (ev) {
  case EV_CANAL_ENVIADO:
    /* canal escolhido: agora lê 2 bytes (o 1º é a conversão anterior, o 2º é a atual) */
    estado_i2c = I2C_LENDO;
    if (HAL_I2C_Master_Receive_IT(&hi2c1, PCF8591_ADDR, adc_rx, 2) != HAL_OK) {
      estado_i2c = I2C_LIVRE;
      uart_print("Erro I2C ao iniciar a leitura\r\n");
    }
    break;

  case EV_LEITURA_OK:
    formata_volts(volts, sizeof(volts), adc_rx[1]);
    snprintf(msg, sizeof(msg), "AIN%u: %u (%s)\r\n", (unsigned)canal_atual, (unsigned)adc_rx[1], volts);
    uart_print(msg);
    break;

  case EV_DAC_OK:
    dac_ligado = 1;
    formata_volts(volts, sizeof(volts), dac_valor);
    snprintf(msg, sizeof(msg), "Valor do DAC: %u (%s)\r\n", (unsigned)dac_valor, volts);
    uart_print(msg);
    break;

  case EV_ERRO:
  default:
    snprintf(msg, sizeof(msg), "Erro I2C (codigo 0x%02lX). Confira fios e alimentacao.\r\n", (unsigned long)hi2c1.ErrorCode);
    uart_print(msg);
    break;
  }
}

/* ---------- callbacks (chamados pelo HAL quando algo termina) ---------- */

void HAL_I2C_MasterTxCpltCallback(I2C_HandleTypeDef *hi2c)
{
  if (hi2c->Instance == I2C1) {
    if (estado_i2c == I2C_ENVIANDO_CANAL) {
      evento_i2c = EV_CANAL_ENVIADO;
    } else if (estado_i2c == I2C_ENVIANDO_DAC) {
      estado_i2c = I2C_LIVRE;
      evento_i2c = EV_DAC_OK;
    }
  }
}

void HAL_I2C_MasterRxCpltCallback(I2C_HandleTypeDef *hi2c)
{
  if (hi2c->Instance == I2C1 && estado_i2c == I2C_LENDO) {
    estado_i2c = I2C_LIVRE;
    evento_i2c = EV_LEITURA_OK;
  }
}

void HAL_I2C_ErrorCallback(I2C_HandleTypeDef *hi2c)
{
  if (hi2c->Instance == I2C1) {
    estado_i2c = I2C_LIVRE;
    evento_i2c = EV_ERRO;
  }
}

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
  if (huart->Instance == USART2) {
    if (rx_char == '\r' || rx_char == '\n') {          /* ENTER: a linha terminou */
      if (idx_linha > 0) {
        linha[idx_linha] = '\0';
        memcpy(comando, linha, idx_linha + 1);
        comando_pronto = 1;
        idx_linha = 0;
      }
    } else if (idx_linha < TAM_LINHA - 1) {
      linha[idx_linha++] = (char)rx_char;
    }
    HAL_UART_Receive_IT(&huart2, &rx_char, 1);         /* continua ouvindo */
  }
}
