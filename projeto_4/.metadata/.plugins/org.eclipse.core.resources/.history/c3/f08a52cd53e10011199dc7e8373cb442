/* USER CODE BEGIN PV */
typedef enum {
  I2C_LIVRE,            /* nenhuma operação I2C em andamento */
  I2C_ENVIANDO_CANAL,   /* enviando o byte de controle (escolha do canal) */
  I2C_LENDO,            /* lendo o resultado da conversão */
  I2C_ENVIANDO_DAC      /* enviando controle + valor do DAC */
} EstadoI2C;

typedef enum {
  EV_NENHUM,
  EV_CANAL_ENVIADO,     /* o byte de controle foi enviado */
  EV_LEITURA_OK,        /* os 2 bytes chegaram */
  EV_DAC_OK,            /* o valor do DAC foi enviado */
  EV_ERRO               /* o I2C falhou (sem resposta, etc.) */
} EventoI2C;

volatile EstadoI2C estado_i2c = I2C_LIVRE;
volatile EventoI2C evento_i2c = EV_NENHUM;

uint8_t rx_char;                    /* último caractere digitado no terminal */
char    linha[TAM_LINHA];           /* linha sendo montada */
uint8_t idx_linha = 0;
char    comando[TAM_LINHA];         /* comando completo, pronto para tratar */
volatile uint8_t comando_pronto = 0;

uint8_t ctrl_tx;                    /* byte de controle enviado ao PCF8591 */
uint8_t dac_tx[2];                  /* {controle, valor} para o DAC */
uint8_t adc_rx[2];                  /* 2 bytes lidos do PCF8591 */
uint8_t canal_atual = 0;            /* canal da leitura em andamento */
uint8_t dac_valor = 0;              /* último valor enviado ao DAC */
uint8_t dac_ligado = 0;             /* 1 depois do primeiro Set_DAC */
/* USER CODE END PV */

